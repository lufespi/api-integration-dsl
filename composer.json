{
    "name": "unisc/api-integration-dsl",
    "description": "DSL para descrever integrações entre APIs HTTP e gerar código PHP (trabalho acadêmico de Linguagens Formais e Compiladores - UNISC).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:unit": "@php vendor/bin/phpunit --testsuite unit",
        "test:integration": "@php vendor/bin/phpunit --testsuite integration"
    },
    "scripts-descriptions": {
        "test": "Executa toda a suíte de testes PHPUnit.",
        "test:unit": "Executa apenas os testes unitários.",
        "test:integration": "Executa apenas os testes de integração (CLI ponta a ponta)."
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
